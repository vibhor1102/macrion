<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:orientation="horizontal">

    <LinearLayout
        android:layout_weight="3"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="2dp"
        android:layout_marginEnd="16dp"
        android:layout_marginVertical="2dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/text_scenario_label"
            style="@style/AppTheme.TextAppearance.Notification.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notification_scenario_label"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="Scenario" />

        <TextView
            android:id="@+id/text_scenario_name"
            style="@style/AppTheme.TextAppearance.Notification.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:maxLines="1"
            android:ellipsize="end"
            tools:text="My cool scenario name" />

    </LinearLayout>

    <ImageButton
        android:id="@+id/button_play_pause"
        style="@style/AppTheme.Notification.Button.Filled"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginHorizontal="8dp"
        android:src="@drawable/ic_notification_play_arrow"
        android:contentDescription="@string/notification_button_play" />

    <ImageButton
        android:id="@+id/button_show_hide"
        style="@style/AppTheme.Notification.Button.Outlined"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_notification_visible_on"
        android:contentDescription="@string/notification_button_show" />

</LinearLayout>
