    <string name="field_scenario_switcher_title">Mostrar seletor de cenários</string>
    <string name="field_scenario_switcher_desc">Exibe o seletor de cenários na barra de ferramentas flutuante para trocas rápidas.</string>
    <string name="field_home_button_title">Mostrar botão inicial do Macrion</string>
