<resources>


    <!-- Base text appearance. -->
    <style name="AppTheme.TextAppearance" />
    <style name="AppTheme.TextAppearance.Body" parent="@android:style/TextAppearance.DeviceDefault.Medium">
        <item name="android:textSize">14sp</item>
    </style>
    <style name="AppTheme.TextAppearance.BodyLarge" parent="@android:style/TextAppearance.DeviceDefault.Large">
